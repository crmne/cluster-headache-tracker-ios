    "Open the app to sign in": {
      "comment": "Widget shown before signing in",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App, um dich anzumelden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app para iniciar sesión"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app per accedere"
          }
        }
      }
    },
    "Opens the quick log so you can record a cluster headache attack in a few taps.": {
      "comment": "App Intent description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Schnellerfassung, damit du eine Clusterkopfschmerz-Attacke mit wenigen Tippern festhalten kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el registro rápido para anotar una crisis de cefalea en racimos con unos pocos toques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la registrazione rapida per annotare un attacco di cefalea a grappolo in pochi tocchi."
          }
        }
      }
    },
    "Opens the quick log.": {
      "comment": "Control description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Schnellerfassung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el registro rápido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la registrazione rapida."
          }
        }
      }
    },
    "Shows how long the current attack has lasted, or how many days you have been attack-free.": {
      "comment": "Widget description in the widget gallery",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wie lange die aktuelle Attacke schon dauert oder wie viele Tage du attackenfrei bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuánto dura la crisis actual o cuántos días llevas sin crisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra da quanto dura l'attacco in corso o da quanti giorni sei senza attacchi."
          }
        }
      }
    },
    "Shows the ongoing attack so you can end it, or starts a new one.": {
      "comment": "App Intent description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die laufende Attacke, damit du sie beenden kannst, oder startet eine neue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la crisis en curso para terminarla, o inicia una nueva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l'attacco in corso per terminarlo, oppure ne avvia uno nuovo."
          }
        }
      }
    },
