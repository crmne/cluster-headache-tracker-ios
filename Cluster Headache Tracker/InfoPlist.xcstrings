    "NSCameraUsageDescription": {
      "comment": "Camera permission",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm Fotos auf, um sie an deine Kopfschmerzeinträge anzuhängen, zum Beispiel deine Sauerstoffausrüstung oder Symptome."
